# ─────────────────────────────────────────────────────────────
#  Copy to `.env` and adjust. Every variable is validated at boot
#  by src/config/env.schema.ts — the app refuses to start if invalid.
# ─────────────────────────────────────────────────────────────

# --- App ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000
API_PREFIX=api
# comma-separated list of allowed browser origins. `*` is accepted outside production only
# (and never together with credentials)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Scalar API reference at /docs + OpenAPI JSON. Defaults to false in production when unset
API_DOCS_ENABLED=true
REQUEST_TIMEOUT_MS=15000
BODY_LIMIT=1mb
# reverse-proxy hops to trust: false | true (= 1) | a number. Set it behind a load balancer
TRUST_PROXY=false
# must be longer than the load balancer's idle timeout (ALB / nginx default: 60s)
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000

# --- Logging -----------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# human-readable logs (dev only; keep JSON in prod)
LOG_PRETTY=true

# --- Database ----------------------------------------------------------
# the only dialect wired today — see docs/05-database.md to add others
DB_CLIENT=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zed_nest
DB_POOL_MAX=10
DB_SSL=false
DB_STATEMENT_TIMEOUT_MS=10000
# fail a query that cannot get a pooled connection within this time (0 = wait forever)
DB_CONNECTION_TIMEOUT_MS=5000
# close pooled connections idle for this long (0 = never)
DB_IDLE_TIMEOUT_MS=30000
# server ends sessions left idle inside a transaction this long (0 = never)
DB_IDLE_IN_TX_TIMEOUT_MS=30000
DB_LOG_QUERIES=false

# --- Auth --------------------------------------------------------------
# Generate secrets: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
# seconds (15 min)
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
# seconds (14 days)
JWT_REFRESH_TTL=1209600
JWT_ISSUER=zed-nest
JWT_AUDIENCE=zed-nest-clients

# --- Rate limiting -----------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- Seeding (pnpm db:seed) ---------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
